{
  "name": "superbikeracing1985",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "build:client": "vite build --config src/client/vite.config.ts",
    "build:server": "vite build --config src/server/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "check": "node scripts/check-wiring.mjs",
    "check:crop": "node scripts/check-crop.mjs",
    "sim:crons": "tsx scripts/sim-crons.ts",
    "test:input": "playwright test",
    "preview": "vite --config src/client/preview.vite.config.ts --host",
    "dev": "devvit playtest",
    "login": "devvit login",
    "upload": "devvit upload"
  },
  "dependencies": {
    "@devvit/web": "0.14.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "devvit": "0.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "license": "BSD-3-Clause"
}
